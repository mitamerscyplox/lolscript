{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/giftcard-checkout.js": { "maxDuration": 60 }
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.lolscript.store/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "lolscript.store"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
