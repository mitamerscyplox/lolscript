{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/giftcard-checkout.js": { "maxDuration": 60 },
    "api/shopier-webhook.js": { "maxDuration": 60 },
    "api/crypto-checkout.js": { "maxDuration": 60 },
    "api/binance-relay.js": { "maxDuration": 20, "regions": ["fra1"] },
    "api/checkout.js": { "maxDuration": 30 }
  },
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth?route=:path*" },
    { "source": "/api/account/:path*", "destination": "/api/auth?route=account/:path*" },
    {
      "source": "/api/:route(analytics|discord-invite|install-guide-video|patch-status|shopier-links|shopier-watch)",
      "destination": "/api/site?route=:route"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.lolscript.store/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "lolscript.store"
        }
      ]
    },
    { "source": "/hanbot", "destination": "/hanbot-key", "permanent": true },
    { "source": "/legend-sense", "destination": "/legend-sense-key", "permanent": true },
    { "source": "/:slug(winnerscript|unixcheats|hile-dunyasi)", "destination": "/lol-hile", "permanent": true },
    {
      "source": "/:slug(hangar-script|justanotherscript|titan-script|nyrex-script|pentasharp|cado-script|hexlol|xxe-script|hera-script|exo-script|phantom-script|reality-cheats|covert-script|devil-script|ciro-script|wh-satano|ven-script|unrevealed-script)",
      "destination": "/lol-script",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
